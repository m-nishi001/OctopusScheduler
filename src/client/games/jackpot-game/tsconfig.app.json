{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@server": ["../../../../server"],
      "@model/*": ["src/model/*"],
      "@shared-composables/*": ["../../packages/shared-composables/src/*"],
      "pages/*": ["src/ui/pages/*"],
      "pages": ["src/ui/pages"],
      "domains/*": ["src/model/domains/*"],
      "applications/*": ["src/model/applications/*"],
      "components/*": ["src/ui/components/*"],
      "components": ["src/ui/components"],
      "packages/common-lib/*": ["../../packages/common-lib/src/*"],
      "server/*": ["../../../../server/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/shared-composables/src/**/*.ts",
    "../../packages/shared-composables/src/**/*.d.ts",
    "../../packages/common-lib/src/**/*.ts",
    "../../packages/common-lib/src/**/*.d.ts",
    "../../packages/**/src/**/*.ts",
    "../../packages/**/src/**/*.d.ts",
    "../../../../server/common/src/**/*.ts",
    "../../../../server/common/src/**/*.d.ts",
    "../../../../../server/common/src/**/*.ts",
    "../../../../../server/common/src/**/*.d.ts",
    "../../../../../../server/common/src/**/*.ts",
    "../../../../../../server/common/src/**/*.d.ts",
    "/root/google_apps_script/octopus-scheduler/src/server/common/src/**/*.ts",
    "/root/google_apps_script/octopus-scheduler/src/server/common/src/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
