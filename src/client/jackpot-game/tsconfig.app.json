{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@server": ["../../../server"],
      "@model/*": ["src/model/*"],
      "@shared-composables/*": ["../shared-composables/src/*"],
      "@shared-composables": ["../shared-composables/src"],
      "pages/*": ["src/ui/pages/*"],
      "pages": ["src/ui/pages"],
      "domains/*": ["src/model/domains/*"],
      "applications/*": ["src/model/applications/*"],
      "components/*": ["src/ui/components/*"],
      "components": ["src/ui/components"],
      "@common-lib/*": ["../common-lib/src/*"],
      "@common-lib": ["../common-lib/src"],
      "@octopus/core": ["../../core/src"],
      "@composables": ["src/composables"],
      "@composables/*": ["src/composables/*"],
      "server/*": ["../../../server/*"]
    }
  },
  "references": [
    { "path": "../../core" },
    { "path": "../common-lib" },
    { "path": "../shared-composables" },
    { "path": "../../server/common" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
