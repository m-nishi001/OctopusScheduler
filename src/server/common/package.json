{
  "name": "shared-packages",
  "version": "1.0.0",
  "description": "A web application built with Google Apps Script, TypeScript, and ESBuild",
  "type": "module",
  "main": "dist/Code.js",
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && clasp push --force"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^20.12.12",
    "esbuild": "^0.25.6",
    "typescript": "^5.4.5"
  }
}
