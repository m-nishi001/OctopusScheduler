{
  "name": "@octopus/server-common",
  "version": "1.0.0",
  "description": "Shared Google Apps Script server contracts and adapters for the monorepo.",
  "type": "module",
  "main": "./src/common-index.ts",
  "types": "./src/common-index.ts",
  "exports": {
    ".": "./src/common-index.ts",
    "./drive-types": "./src/drive-types.ts",
    "./google-drive-service": "./src/google-drive-service.ts",
    "./google-form-service": "./src/google-form-service.ts",
    "./google-spreadsheet-service": "./src/google-spreadsheet-service.ts",
    "./gas-types": "./src/gas-types.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.config.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && clasp push --force"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^20.12.12"
  }
}
