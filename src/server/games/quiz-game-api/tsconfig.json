{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020", // Target environment (GAS V8 runtime supports modern JS)
    "module": "ESNext", // Use modern module system, ESBuild will handle bundling
    "lib": ["ESNext"],
    "useDefineForClassFields": true,
    "strict": true, // Enable all strict type-checking options
    "esModuleInterop": true, // Enables emit interoperability between CommonJS and ES Modules
    "skipLibCheck": true, // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true, // Disallow inconsistently-cased references to the same file.
    "moduleResolution": "bundler", // How modules get resolved (node is common for build tools)
    "resolveJsonModule": true, // Allow importing JSON files
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "declarationMap": false,
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "rootDirs": ["src", "../../../../shared-packages/src"],
    "paths": {
      "shared-packages": ["../../../../shared-packages/dist/types"],
      "@octopus/server-common": ["../../common/src"],
      "@octopus/server-common/*": ["../../common/src/*"]
    }
  },
  "include": ["src/**/*", "../../common/src/**/*", "../../../../shared-packages/src/**/*"],
  "exclude": [
    "node_modules", // Exclude dependencies
    "dist" // Exclude build output directory
  ]
}
