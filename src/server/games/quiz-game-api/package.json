{
  "name": "quiz-game-api",
  "version": "1.0.0",
  "description": "A web application built with Google Apps Script, TypeScript, and ESBuild",
  "type": "module",
  "main": "dist/Code.js",
  "scripts": {
    "build": "node esbuild.config.js",
