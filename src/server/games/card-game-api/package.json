{
  "name": "card-game-api",
  "version": "1.0.0",
  "description": "A web application built with Google Apps Script, TypeScript, and ESBuild",
  "type": "module",
  "main": "dist/Code.js",
  "scripts": {
    "build": "tsc -b && node esbuild.config.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc -b --pretty false",
    "deploy": "npm run build && clasp push --force"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83"
  }
}
