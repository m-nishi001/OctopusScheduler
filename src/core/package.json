{
  "name": "@octopus/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent shared contracts used by both client and server.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
