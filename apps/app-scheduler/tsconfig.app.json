{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    /* 型検査のためだけに -b で実行する。ソースの隣に成果物を出さないよう、宣言ファイルだけを node_modules/.tmp に出す */
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./node_modules/.tmp/types",
    "outDir": "./node_modules/.tmp/out",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@model/*": ["./src/client/model/*"],
      "@control/*": ["./src/client/control/*"],
      "@ui/*": ["./src/client/ui/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.vue"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/infrastructures" },
    { "path": "../../packages/client-common" },
    { "path": "../../packages/composables" },
    { "path": "../../packages/sync-engine" },
    { "path": "../../packages/game-quiz" },
    { "path": "../../packages/game-jackpot" },
    { "path": "../../packages/table-io" }
  ]
}
