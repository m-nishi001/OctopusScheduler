{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "model/*": ["./src/client/*"],
      "ui/*": ["./src/client/ui/*"],
      "core/*": ["./src/client/core/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.vue"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/infrastructures" },
    { "path": "../../packages/client-common" },
    { "path": "../../packages/composables" },
    { "path": "../../packages/game-card" },
    { "path": "../../packages/game-quiz" },
    { "path": "../../packages/game-jackpot" }
  ]
}
