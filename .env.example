# OctopusScheduler Environment Configuration
# 
# This file contains example environment variables used by the OctopusScheduler application.
# Copy this file to .env and fill in with actual values.
# 
# The following configuration keys are managed via Google Apps Script's PropertiesService
# in the cloud, but can be overridden using environment variables for local development.

# ========================
# Card Game Configuration
# ========================
# Spreadsheet ID for card game data storage
CARD_GAME_API_SPREADSHEET=your_spreadsheet_id_here

# ========================
# Jackpot Game Configuration
# ========================
# Folder ID in Google Drive where jackpot game JSON data is stored
JACKPOT_GAME_JSON_FOLDER=your_google_drive_folder_id_here

# Folder ID in Google Drive where jackpot game assets are stored
JACKPOT_GAME_ASSET_FOLDER=your_google_drive_folder_id_here

# ========================
# Quiz Game Configuration
# ========================
# Folder ID in Google Drive where quiz game JSON data is stored
QUIZ_GAME_JSON_FOLDER=your_google_drive_folder_id_here

# Folder ID in Google Drive where quiz game assets are stored
QUIZ_GAME_ASSET_FOLDER=your_google_drive_folder_id_here

# ========================
# Octopus Scheduler Configuration
# ========================
# Folder ID in Google Drive where scheduler JSON data is stored
OCTOPUS_SCHEDULER_JSON_FOLDER=your_google_drive_folder_id_here

# Folder ID in Google Drive where scheduler assets are stored
OCTOPUS_SCHEDULER_ASSET_FOLDER=your_google_drive_folder_id_here

# Keyboard shortcuts configuration JSON (as string)
KEYBOARD_SHORTCUTS_CONFIG={"shortcuts":"example_shortcuts_json"}

# ========================
# Google Apps Script Configuration
# ========================
# Time zone setting for Google Apps Script
TZ=Asia/Tokyo

# ========================
# Development Configuration
# ========================
# Development server host (for vite dev servers)
DEV_HOST=localhost

# Development server port
DEV_PORT=5173
