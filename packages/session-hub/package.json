{
  "name": "@octopus/session-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "セッション(パーティールーム)を中心に、ホスト・管理・クライアント端末を結ぶコマンド/状態チャネル。サーバ側エンジンとクライアントの購読・コマンド発行を提供する。",
  "main": "./src/client/index.ts",
  "types": "./src/client/index.ts",
  "exports": {
    ".": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "import": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    },
    "./engine": {
      "types": "./src/server/engine/index.ts",
      "import": "./src/server/engine/index.ts",
      "default": "./src/server/engine/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./server": {
      "types": "./src/server/endpoints.ts",
      "import": "./src/server/endpoints.ts",
      "default": "./src/server/endpoints.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest"
  },
  "dependencies": {
    "@octopus/accounts": "*",
    "@octopus/client-common": "*",
    "@octopus/infrastructures": "*",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^20.12.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
