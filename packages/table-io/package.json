{
  "name": "@octopus/table-io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "表(CSV / ZIP)の一括書き出し・取込の共通部品。純粋関数だけで、画面や通信には依存しない。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
