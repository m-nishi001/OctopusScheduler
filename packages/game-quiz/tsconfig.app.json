{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* 型検査のためだけに -b で実行する。ソースの隣に成果物を出さないよう、宣言ファイルだけを node_modules/.tmp に出す */
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./node_modules/.tmp/types",
    "outDir": "./node_modules/.tmp/out",
    "lib": ["ES2022", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitOnError": false,
    "paths": {
      "@model/*": ["./src/client/model/*"],
      "@control/*": ["./src/client/control/*"],
      "@ui/*": ["./src/client/ui/*"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.vue", "src/server/quiz-api-contract.ts"],
  "references": [
    { "path": "../client-common" },
    { "path": "../composables" },
    { "path": "../infrastructures" },
    { "path": "../sync-engine" }
  ]
}
