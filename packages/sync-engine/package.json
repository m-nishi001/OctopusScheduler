{
  "name": "@octopus/sync-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "複数の同期対象(ファイル/JSONブロブ)をファイル単位で差分検出し、環境ごとに並列度を切り替えて同期する共通エンジン。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest"
  },
  "dependencies": {
    "@octopus/client-common": "*",
    "@octopus/infrastructures": "*",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
