{
  "name": "@octopus/client-common",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side shared services for Apps Script and browser utilities.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^20.12.12",
    "core-js": "^3.44.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "dependencies": {
    "@octopus/core": "*",
    "localforage": "^1.10.0",
    "mitt": "^3.0.1"
  }
}
